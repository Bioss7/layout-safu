{
  "name": "landing-moscow-transport",
  "version": "1.0.0",
  "description": "Vite + pnpm build: SCSS -> CSS (autoprefix + minify), JS bundle, static assets",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm run project:data:check && pnpm run remarks:md && vite build && pnpm run format:css:build",
    "project:data:check": "node tools/project-data.mjs",
    "remarks:md": "node tools/project-data.mjs --remarks-md",
    "check:project-data": "node --test tools/project-data.test.mjs",
    "format:styles": "prettier --write \"src/scss/abiturient/**/*.scss\" \"src/scss/students/**/*.scss\" ui/ui.css",
    "format:styles:check": "prettier --check \"src/scss/abiturient/**/*.scss\" \"src/scss/students/**/*.scss\" ui/ui.css",
    "format:css:build": "prettier --write --ignore-path .prettierignore.build dist/assets/css/abiturient.css dist/assets/css/students.css \"dist/ui/**/*.css\"",
    "preview": "vite preview",
    "stats": "node tools/ai-statistics.mjs",
    "check:statistics": "node --test tools/ai-statistics.test.mjs",
    "check:format-on-save": "node --test tools/format-on-save.test.mjs",
    "check:abiturient": "node tools/check-abiturient.mjs",
    "webp": "node convert-to-webp.mjs",
    "optimize": "node optimize-images.mjs",
    "test": "echo \"Error: no test specified\" && exit 1",
    "check:typography": "node tools/check-typography.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bioss7/landing-moscow-transport.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Bioss7/landing-moscow-transport/issues"
  },
  "homepage": "https://github.com/Bioss7/landing-moscow-transport#readme",
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "autoprefixer": "^10.5.4",
    "prettier": "3.9.10",
    "sass": "^1.102.0",
    "sharp": "^0.35.3",
    "vite": "^7.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "@parcel/watcher"
    ]
  }
}
